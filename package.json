{
  "name": "agence-elite-crm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node site/build.mjs dist/site",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:site": "playwright test -c site/playwright.config.mjs",
    "mesure:site": "node site/build.mjs site-dist && node site/scripts/mesure.cjs --dir site-dist",
    "check": "oxlint && vitest run && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.56.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
