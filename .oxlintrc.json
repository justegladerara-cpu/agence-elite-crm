{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "ignorePatterns": [
    "public/recrutement/**",
    "dist*/**",
    "scripts/plateforme-fictive/instantane/**",
    "site-dist/**"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "overrides": [
    {
      "files": [
        "scripts/**",
        "site/**",
        "functions/**",
        "tests/**",
        "e2e/**",
        "*.config.js",
        "*.config.mjs"
      ],
      "env": {
        "node": true,
        "browser": true,
        "es2024": true
      }
    },
    {
      "files": [
        "supabase/functions/**"
      ],
      "globals": {
        "Deno": "readonly"
      }
    }
  ]
}